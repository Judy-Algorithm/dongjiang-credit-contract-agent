# HKGAI文本模型（OpenAI兼容接口）
OPENAI_BASE_URL=https://test-new-api.hkchat.app/v1
OPENAI_API_KEY=replace-with-text-model-api-key
OPENAI_MODEL=replace-with-model-id
DONGJIANG_AI_ASSISTANCE_ENABLED=false
# 主 Agent 大模型计划提议层；默认关闭，失败或非法提议会自动回退确定性计划。
DONGJIANG_ORCHESTRATOR_LLM_PLANNING_ENABLED=false
# 对本地已提取但质量不高的脱敏文字调用文本模型做字段增强；不是多模态识图。
DONGJIANG_DOCUMENT_TEXT_ENHANCEMENT_ENABLED=false
# 本机单机部署可设为true，让项目.env覆盖启动进程残留的同名变量；容器生产环境保持false。
DONGJIANG_ENV_FILE_OVERRIDE=false

# OCR（留空时自动发现本机 Tesseract；Docker 镜像已安装五语语言包）
DONGJIANG_TESSERACT_CMD=
DONGJIANG_TESSDATA_PREFIX=
DONGJIANG_OCR_LANGUAGES=chi_sim+eng+vie+jpn+spa

# HKGAI语音能力
HKGAI_SPEECH_BASE_URL=https://openspeech.hkgai.net
HKGAI_SPEECH_API_KEY=replace-with-speech-api-key

# HKGAI Toolhub / Agenthub（共用同一组App凭证）
# 当前运行时使用local注册中心；拿到官方接口文档后切换为remote并接入适配器。
DONGJIANG_AGENT_REGISTRY_PROVIDER=local
DONGJIANG_TOOL_REGISTRY_PROVIDER=local
HKGAI_TOOLHUB_BASE_URL=https://toolhub.prod.hkchat.app
HKGAI_AGENTHUB_BASE_URL=https://search-agent.prod.hkchat.app/v1
HKGAI_APP_NAME=replace-with-app-name
HKGAI_APP_KEY=replace-with-app-key

# Web会话（HTTPS生产部署必须设为true；本地HTTP开发保持false）
DONGJIANG_COOKIE_SECURE=false
DONGJIANG_PUBLIC_URL=https://credit.example.com
DONGJIANG_SLA_MONITOR_ENABLED=true
DONGJIANG_SLA_SCAN_INTERVAL_SECONDS=900

# Password reset email (QQ Mail: smtp.qq.com:465 with an authorization code)
DONGJIANG_SMTP_HOST=
DONGJIANG_SMTP_PORT=465
DONGJIANG_SMTP_USERNAME=
DONGJIANG_SMTP_PASSWORD=
DONGJIANG_SMTP_FROM=
DONGJIANG_SMTP_USE_SSL=true
DONGJIANG_SMTP_STARTTLS=false

# 东江企业系统回写（未配置时仅记录 not_configured，不会伪造成功）
DONGJIANG_OA_BASE_URL=
DONGJIANG_OA_TOKEN=
DONGJIANG_OA_CALLBACK_TOKEN=
DONGJIANG_OA_HEADERS_JSON={}
DONGJIANG_CRM_BASE_URL=
DONGJIANG_CRM_TOKEN=
DONGJIANG_CRM_HEADERS_JSON={}
DONGJIANG_SAP_BASE_URL=
DONGJIANG_SAP_TOKEN=
DONGJIANG_SAP_HEADERS_JSON={}
# 比赛演示可设为mock；生产必须留空并配置上面的真实地址。
DONGJIANG_INTEGRATION_MODE=
DONGJIANG_MOCK_ENTERPRISE_ROOT=data/mock-enterprise
